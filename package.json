{
  "name": "prompt-foundry",
  "publisher": "sdevries",
  "displayName": "Prompt Foundry",
  "description": "Forge complex AI prompts and specs from a library of evolving blocks.",
  "version": "0.3.2",
  "icon": "assets/150.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simondevries/prompt-foundry"
  },
  "keywords": [
    "prompt",
    "ai",
    "llm",
    "mcp",
    "cursor",
    "claude",
    "prompt-engineering"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onView:prompt-forge-sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prompt-forge-sidebar",
          "title": "Prompt Foundry",
          "icon": "assets/logo.svg"
        }
      ]
    },
    "views": {
      "prompt-forge-sidebar": [
        {
          "type": "webview",
          "id": "prompt-forge.mainPrompt",
          "name": "Prompt Foundry",
          "icon": "$(edit)"
        }
      ]
    },
    "commands": [
      {
        "command": "prompt-forge.sendToAI",
        "title": "Send to AI"
      },
      {
        "command": "prompt-forge.editPrompt",
        "title": "Edit Prompt Block"
      }
    ],
    "configuration": {
      "title": "Prompt Foundry",
      "properties": {
        "promptForge.promptFolder": {
          "type": "string",
          "default": "",
          "description": "Custom folder for storing prompts. If empty, defaults to ~/Prompt Library."
        },
        "promptForge.showClaudeCodeBlocks": {
          "type": "boolean",
          "default": false,
          "description": "Show Claude Code skills, commands, and instructions as prompt blocks."
        },
        "promptForge.showCursorRules": {
          "type": "boolean",
          "default": false,
          "description": "Show Cursor rules and .mdc files as prompt blocks."
        },
        "promptForge.showWorkspaceSkills": {
          "type": "boolean",
          "default": false,
          "description": "Show skills from your workspace as prompt blocks."
        },
        "promptForge.customFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of absolute folder paths to include in the prompt library as read-only categories."
        },
        "promptForge.historyRetentionLimit": {
          "type": "number",
          "default": 50,
          "description": "Number of sessions to keep in history. 0 means unlimited."
        },
        "promptForge.mentionExcludeFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            "dist",
            "out",
            ".git",
            ".pnpm-store"
          ],
          "description": "Folders to exclude from @ mention file search."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "build:tui": "esbuild src/tui/index.tsx --bundle --platform=node --format=esm --outfile=dist/tui.bundle.mjs --alias:react-devtools-core=./src/core/stubs.ts --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --external:assert --external:fs --external:path --external:os --external:util --external:child_process --external:events --external:stream --external:tty --external:url --external:module --external:process",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --outfile=dist/mcp.bundle.js",
    "build:all": "pnpm run compile && pnpm run build:tui && pnpm run build:mcp",
    "tui": "node dist/tui.bundle.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "copy-webpack-plugin": "^14.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "ts-loader": "^9.5.4",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@vscode/codicons": "^0.0.45",
    "diff": "^8.0.4",
    "ink": "^7.0.4",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
